class Solution {
    public long minEnd(int n, int x) {
        long ans = x;
        n--;
        int bit = 0;
        while (n > 0) {
            if ((ans & (1L << bit)) == 0) {
                if ((n & 1) == 1) {
                    ans |= (1L << bit);
                }
                n >>= 1;
            }
            bit++;
        }
        return ans;
    }
}
